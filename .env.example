# Copie para `.env` no servidor e ajuste. Nunca comite o `.env`.

# Obrigatório: token exigido em todas as rotas /api/* e no painel.
# Use um segredo longo (ex.: `openssl rand -hex 32`).
LOG_TOKEN=troque-por-um-segredo-longo

# Porta e interface. Deixe 127.0.0.1 e exponha pelo nginx (TLS).
PORT=8787
HOST=127.0.0.1

# Onde os arquivos NDJSON ficam.
DATA_DIR=./data

# Quantos dias de log manter (limpeza automática a cada 6 h).
LOG_RETENTION_DAYS=30

# Tamanho máximo de cada requisição de ingestão.
LOG_MAX_BODY_BYTES=262144

# Opcional: habilita CORS apenas para esta origem (normalmente não é preciso,
# o app nativo não passa por CORS e o painel é servido na mesma origem).
# LOG_ALLOWED_ORIGIN=https://logs.suavps.com
